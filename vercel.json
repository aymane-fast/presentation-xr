{
  "rewrites": [
    {"source": "/analyse", "destination": "/analyse.html"},
    {"source": "/immersive", "destination": "/analyse.html"},
    {"source": "/calcul-sus", "destination": "/calcul-sus.html"},
    {"source": "/admin", "destination": "/admin.html"}
  ],
  "headers": [
    {"source": "/api/(.*)", "headers": [
      {"key": "Cache-Control", "value": "no-store"},
      {"key": "X-Content-Type-Options", "value": "nosniff"}
    ]}
  ]
}
